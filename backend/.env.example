# ==============================================================================
# Database & Cache
# ==============================================================================
DATABASE_URL="mysql://scheduler_user:scheduler_password@localhost:3306/email_scheduler"
REDIS_HOST="localhost"
REDIS_PORT="6379"

# ==============================================================================
# Search Engine
# ==============================================================================
ELASTICSEARCH_URL="http://localhost:9200"

# ==============================================================================
# Authentication & Security
# ==============================================================================
JWT_SECRET="replace-with-a-secure-random-jwt-secret-min-32-chars"

# ------------------------------------------------------------------------------
# GOOGLE CLOUD CONSOLE OAUTH 2.0 SETUP INSTRUCTIONS:
# 1. Open Google Cloud Console: https://console.cloud.google.com/
# 2. Create a new project (e.g., "reachinbox-scheduler") or select an existing one.
# 3. Navigate to: APIs & Services > OAuth consent screen
#    - User Type: "External" (or "Internal" if using Google Workspace)
#    - App Information:
#        App name: ReachInbox Email Scheduler
#        User support email: <your-email>
#        Developer contact information: <your-email>
#    - Scopes: Click "ADD OR REMOVE SCOPES" and select:
#        - .../auth/userinfo.email (User email)
#        - .../auth/userinfo.profile (Basic profile)
#        - openid
#    - Test Users: Add the Gmail address(es) you will use for testing while app is in "Testing" mode.
# 4. Navigate to: APIs & Services > Credentials
#    - Click: "+ CREATE CREDENTIALS" > "OAuth client ID"
#    - Application type: "Web application"
#    - Name: "ReachInbox Web App"
#    - Authorized JavaScript origins:
#        http://localhost:5173
#        http://localhost:5000
#    - Authorized redirect URIs:
#        http://localhost:5000/auth/google/callback
#        http://localhost:5000/api/auth/google/callback
# 5. Click "CREATE", then copy Client ID & Client Secret below.
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:5000/auth/google/callback"

# ==============================================================================
# Email Delivery (SMTP / Ethereal)
# ------------------------------------------------------------------------------
MAIL_PROVIDER="smtp"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM_NAME="Your Name"
SMTP_FROM_EMAIL="your-email@gmail.com"

# Ethereal Fallback (Alternative test mailer):
ETHEREAL_USER="your-ethereal-user@ethereal.email"
ETHEREAL_PASS="your-ethereal-password"

# ==============================================================================
# Slack Integration
# ==============================================================================
SLACK_CLIENT_ID="your-slack-client-id"
SLACK_CLIENT_SECRET="your-slack-client-secret"
SLACK_REDIRECT_URI="http://localhost:5000/api/slack/callback"

# ==============================================================================
# Rate Limiting & Worker Concurrency
# ==============================================================================
MAX_EMAILS_PER_HOUR="50"
MIN_DELAY_BETWEEN_EMAILS_MS="2000"
WORKER_CONCURRENCY="5"

# ==============================================================================
# Bull Board Dashboard Authentication
# ==============================================================================
BULLBOARD_USER="admin"
BULLBOARD_PASS="admin123"

# ==============================================================================
# Server Configuration
# ==============================================================================
PORT="5000"
FRONTEND_URL="http://localhost:5173"
